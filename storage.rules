rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return isSignedIn()
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    // Mirrors firestore.rules' isApprovedUser(): a legacy account with no
    // `status` field is grandfathered in as approved; a freshly
    // self-registered account starts at 'pendente' and stays unapproved
    // until an admin flips it to 'ativo'.
    function isApprovedUser() {
      return isSignedIn() && (
        !('status' in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data)
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'ativo'
      );
    }

    function isPrivileged() {
      return isApprovedUser() && (role() == 'admin' || role() == 'gerente');
    }

    function isValidAttachment() {
      return request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|gif|webp)|application/pdf|application/vnd.openxmlformats-officedocument.(wordprocessingml.document|spreadsheetml.sheet)|application/msword|application/vnd.ms-excel');
    }

    function isValidAvatar() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    match /attachments/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isPrivileged());
      allow create, update: if isApprovedUser() && role() != 'visualizador'
        && request.auth.uid == userId && isValidAttachment();
      allow delete: if isApprovedUser() && request.auth.uid == userId;
    }

    match /avatars/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidAvatar();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
