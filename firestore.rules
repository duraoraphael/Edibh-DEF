rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return isSignedIn() ? userDoc().data.role : null;
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isGerente() {
      return role() == 'gerente';
    }

    function isTecnico() {
      return role() == 'tecnico';
    }

    function isAdminOrGerente() {
      return isAdmin() || isGerente();
    }

    function isOwner(authorId) {
      return isSignedIn() && request.auth.uid == authorId;
    }

    // users: everyone signed in can read (for author names, avatars); only
    // admin may change roles, self may update own non-role profile fields.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId
            && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // records: admin/gerente full access; tecnico may create and may only
    // edit/delete records they authored; visualizador is read-only.
    match /records/{recordId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && role() != 'visualizador'
        && request.resource.data.authorId == request.auth.uid;
      allow update: if (isAdminOrGerente()
          || (isTecnico() && resource.data.authorId == request.auth.uid))
        && request.resource.data.authorId == resource.data.authorId;
      allow delete: if isAdmin();

      match /updates/{updateId} {
        function ownsParentRecord() {
          return isTecnico()
            && get(/databases/$(database)/documents/records/$(recordId)).data.authorId == request.auth.uid;
        }
        allow read: if isSignedIn();
        allow create, update, delete: if isAdminOrGerente() || ownsParentRecord();
      }
    }

    // approvals: doc id == record id, and every approval doc carries its own
    // `authorId` (denormalized from the parent record) so this check never
    // needs get() on another document — safe even when the approval and its
    // parent record are written in the same atomic transaction, where a
    // get() could race against the record's own pending write. Admin/gerente
    // always act on approvals; a tecnico may create/update the approval for
    // a record they authored (needed so their own submission and their own
    // status changes succeed).
    match /approvals/{approvalId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrGerente()
        || (isSignedIn() && role() != 'visualizador' && request.resource.data.authorId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // form definitions: admin/gerente manage fields; everyone reads (needed
    // to render the "new record" form).
    match /formFields/{formId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrGerente();

      match /updates/{updateId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    // audit log: append-only by any signed-in user (actions are always tied
    // to the authenticated actor); no client may edit or delete history.
    match /logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    match /emailLogs/{logId} {
      allow read: if isAdminOrGerente();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    // notifications: any signed-in user may create (fan-out to recipients);
    // recipients read only their own and may only flip the `read` flag.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // shared, per-year sequence counters used to generate record numbers
    // ("recordCounter_2026", "recordCounter_2027", ...). Any signed-in
    // non-visualizador user may advance a record counter (needed so a
    // tecnico's own submission can atomically claim the next sequential
    // number); every other setting stays admin/gerente-only.
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrGerente()
        || (settingId.matches('recordCounter(_[0-9]{4})?') && isSignedIn() && role() != 'visualizador');
    }
  }
}
