# Copy to .env.local (gitignored) and fill in real values. Also set the same
# vars in Vercel → Project → Settings → Environment Variables.
#
# SECURITY: this Firebase apiKey was previously hardcoded as a fallback in
# src/lib/firebase.ts and committed to git history. It is not a traditional
# secret (Firebase web config is public by design, enforced by security
# rules instead), but since it was committed, restrict it in Google Cloud
# Console → APIs & Services → Credentials (HTTP referrer restriction to your
# production domain) and consider regenerating it if unrestricted exposure
# is a concern.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Upstash Redis — server-only, required for login brute-force rate limiting
# (src/lib/rate-limit.ts). Without these set, rate limiting fails open.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
