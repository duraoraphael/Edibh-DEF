# Copy this file to .env.local for development. Configure the same variables
# in Vercel -> Project -> Settings -> Environment Variables for production.
# Never put real server-side secrets in this example file.

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cim-normatel-ac5b7.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cim-normatel-ac5b7
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=cim-normatel-ac5b7.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=612881372973
NEXT_PUBLIC_FIREBASE_APP_ID=1:612881372973:web:784ed324cefe5d2d7ea5a4

# Resend - server-only. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Fluxo de Equipamentos Criticos <fluxo@seu-dominio.com>

# Upstash Redis - server-only, required for distributed rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
